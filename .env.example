# yot-server environment configuration
# Copy this file to .env and adjust values as needed

# Server port (default: 4010)
# PORT=4010

# Data directory (default: ~/.yot)
# YOT_DATA_DIR=~/.yot

# Database path (default: $YOT_DATA_DIR/data.db)
# DB_PATH=$YOT_DATA_DIR/data.db

# Image directory (default: $YOT_DATA_DIR/img)
# IMG_DIR=$YOT_DATA_DIR/img

# MCP authentication (default: true)
# MCP_AUTH=true

# API key for client authentication (optional)
# If not set, no authentication is required
# YOT_API_KEY=your-secret-key-here

# HTTP URL for this server (default: http://127.0.0.1:4010)
# Used for generating absolute URLs in responses
# YOT_HTTP_URL=http://127.0.0.1:4010

# SSE relay enabled (default: true)
# YOT_SSE_RELAY=true

# --- Hermes Integration (for Ask feature) ---

# Hermes API endpoint URL
# Default: http://127.0.0.1:8642/v1/chat/completions
# HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions

# Hermes API key (required for Ask feature)
# Get this from your Hermes config: ~/.hermes/config.yaml under platforms.api_server.key
# HERMES_API_KEY=your-hermes-api-key-here

# Default AI model for Ask requests (default: hermes-agent)
# When client doesn't specify a model, this is used
# HERMES_DEFAULT_MODEL=hermes-agent

# Allowed models for client selection (comma-separated)
# If empty, no model selection UI is shown in client
# Examples:
#   HERMES_ALLOWED_MODELS=hermes-agent,openai/gpt-4o
#   HERMES_ALLOWED_MODELS=hermes-agent,anthropic/claude-3-5-sonnet-20241022,openai/gpt-4o
HERMES_ALLOWED_MODELS=
