{
	"name": "yot",
	"type": "module",
	"scripts": {
		"dev": "cd server-rs && cargo run --bin yot-server",
		"build": "cd server-rs && cargo build --release && npm --prefix web run build",
		"web:dev": "npm --prefix web run dev",
		"web:build": "npm --prefix web run build",
		"start": "server-rs/target/release/yot-server",
		"mcp": "server-rs/target/release/yot-mcp",
		"test": "cd server-rs && cargo test",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16"
	}
}
